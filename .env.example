# LLM provider: anthropic (real runs) | stub (offline scripted stub, tests only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
# Hard cap on cumulative LLM spend across all runs (persisted in results/cost_ledger.json)
TOTAL_COST_CAP_USD=3.0
# Pricing (USD per million tokens) used for cost accounting
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
LLM_PRICE_CACHE_WRITE_PER_MTOK=0.125
LLM_PRICE_CACHE_READ_PER_MTOK=0.01
LOG_LEVEL=WARNING
